{
  "format": 1,
  "kind": "thing",
  "name": "stem",
  "vars": {
    "order": { "type": "number", "value": 1, "perCopy": true },
    "look": { "type": "picture", "value": "stem-shin.png", "perCopy": true },
    "len": { "type": "number", "value": 68, "perCopy": true },
    "angle": { "type": "number", "value": 14, "perCopy": true },
    "note": { "type": "number", "value": 0, "perCopy": true },
    "shown": { "type": "number", "value": 0 }
  },
  "frames": [
    {
      "title": "one ikebana stem: unseen until its turn, then from her hand into the vase, turning to its angle",
      "at": [20, 30],
      "size": [1520, 674],
      "colour": "#c06f9a"
    },
    {
      "title": "how it looks; landing: a note, and her basket gives up its share of blossom",
      "at": [20, 724],
      "size": [1020, 516],
      "colour": "#9a7ad0"
    }
  ],
  "nodes": {
    "told": { "type": "on-message", "set": { "message": "stem" }, "at": [40, 80] },
    "order": { "type": "get-var", "set": { "var": "order" }, "at": [40, 238] },
    "basket": { "type": "get-var", "set": { "var": "basket" }, "at": [40, 352] },
    "basketnum": { "type": "to-number", "at": [40, 466] },
    "mine": { "type": "compare", "set": { "op": "=" }, "at": [290, 80] },
    "enough": { "type": "compare", "set": { "op": "≤" }, "at": [290, 216] },
    "both": { "type": "logic", "set": { "op": "and" }, "at": [540, 80] },
    "myturn": { "type": "branch", "at": [540, 216] },
    "steps": { "type": "sequence", "at": [790, 80] },
    "appear": { "type": "set-var", "set": { "var": "shown", "value": 1 }, "at": [1040, 80] },
    "vase": { "type": "find", "set": { "kind": "vase" }, "at": [1040, 216] },
    "vaseat": { "type": "position-of", "at": [1040, 330] },
    "mouth": { "type": "make-position", "set": { "z": 85 }, "at": [1290, 80] },
    "fly": { "type": "move-to", "set": { "seconds": 0.66, "arc": 20 }, "at": [1290, 208] },
    "turn": { "type": "ramp", "set": { "seconds": 0.66, "from": 69, "curve": "ease-in-out" }, "at": [1290, 440] },
    "shown": { "type": "get-var", "set": { "var": "shown" }, "at": [40, 774] },
    "len": { "type": "get-var", "set": { "var": "len" }, "at": [40, 888] },
    "look": { "type": "get-var", "set": { "var": "look" }, "at": [40, 1002] },
    "angle": { "type": "get-var", "set": { "var": "angle" }, "at": [40, 1116] },
    "pic": { "type": "picture", "set": { "sway": 0.15, "shadow": 0 }, "at": [290, 774] },
    "note": { "type": "get-var", "set": { "var": "note" }, "at": [540, 774] },
    "ring": { "type": "chime", "set": { "note": "C5", "tone": "pluck", "volume": 0.4 }, "at": [540, 888] },
    "stems": { "type": "math", "set": { "op": "min", "b": 3 }, "at": [790, 774] },
    "share": { "type": "math", "set": { "op": "÷" }, "at": [790, 910] },
    "give": { "type": "add-to-var", "set": { "var": "given" }, "at": [790, 1046] }
  },
  "wires": [
    ["told.data", "mine.a"],
    ["order.value", "mine.b"],
    ["order.value", "enough.a"],
    ["basket.value", "basketnum.value"],
    ["basketnum.value", "enough.b"],
    ["mine.result", "both.a"],
    ["enough.result", "both.b"],
    ["told.received", "myturn.go"],
    ["both.result", "myturn.condition"],
    ["myturn.yes", "steps.go"],
    ["steps.first", "appear.go"],
    ["steps.second", "fly.go"],
    ["steps.third", "turn.play"],
    ["vase.thing", "vaseat.thing"],
    ["vaseat.x", "mouth.x"],
    ["vaseat.y", "mouth.y"],
    ["mouth.position", "fly.to"],
    ["angle.value", "turn.to"],
    ["shown.value", "pic.opacity"],
    ["len.value", "pic.height"],
    ["look.value", "pic.picture"],
    ["turn.value", "pic.turn"],
    ["fly.arrived", "ring.go"],
    ["note.value", "ring.bend"],
    ["ring.then", "give.go"],
    ["basketnum.value", "stems.a"],
    ["basketnum.value", "share.a"],
    ["stems.result", "share.b"],
    ["share.result", "give.amount"]
  ]
}
